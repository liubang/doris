# CLucene - Full-text search engine (Doris fork)
# Built via CMake using rules_foreign_cc

load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

cmake(
    name = "clucene",
    build_args = ["-j"],
    cache_entries = {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_STATIC_LIBS": "ON",
        "BUILD_CONTRIBS_LIB": "ON",
    },
    lib_source = ":all_srcs",
    out_static_libs = [
        "libclucene-core-static.a",
        "libclucene-shared-static.a",
        "libclucene-contribs-lib.a",
    ],
    # _clucene-config.h is generated by configure_file into the build dir
    # but has no install rule, so we copy it manually to the install include dir.
    # Also copy contribs-lib headers which aren't installed by cmake.
    #
    # NOTE: rules_foreign_cc bug - only $$EXT_BUILD_ROOT$$ is protected from
    # ctx.expand_make_variables $$ stripping. Use $$$$INSTALLDIR$$$$ as workaround.
    #
    # NOTE: cmake install creates read-only hardlinks from sandbox inputs.
    # chmod won't work; must rm before overwriting conflicting files.
    # cmake installs only LanguageBasedAnalyzer.h and cjk/CJKAnalyzer.h from contribs.
    postfix_script = """
set -e
cp src/shared/CLucene/_clucene-config.h $$$$INSTALLDIR$$$$/include/CLucene/_clucene-config.h
rm -f $$$$INSTALLDIR$$$$/include/CLucene/analysis/LanguageBasedAnalyzer.h
rm -f $$$$INSTALLDIR$$$$/include/CLucene/analysis/cjk/CJKAnalyzer.h
cp -r $$EXT_BUILD_ROOT$$/external/+cpp_deps+clucene/src/contribs-lib/CLucene/analysis/* $$$$INSTALLDIR$$$$/include/CLucene/analysis/
cp -r $$EXT_BUILD_ROOT$$/external/+cpp_deps+clucene/src/contribs-lib/CLucene/util/* $$$$INSTALLDIR$$$$/include/CLucene/util/
cp -r $$EXT_BUILD_ROOT$$/external/+cpp_deps+clucene/src/contribs-lib/CLucene/highlighter $$$$INSTALLDIR$$$$/include/CLucene/ || true
""",
    deps = [
        "@zlib",
        "@boost.filesystem//:boost.filesystem",
    ],
)
