# pugixml - Light-weight, simple and fast XML parser for C++
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "pugixml",
    srcs = ["src/pugixml.cpp"],
    hdrs = [
        "src/pugiconfig.hpp",
        "src/pugixml.hpp",
    ],
    includes = ["src"],
)
