+  /**
+   * StreamId identifies a specific stream within a stripe (Doris extension).
+   */
+  struct StreamId {
+    uint64_t column;
+    StreamKind kind;
+
+    StreamId() : column(0), kind(StreamKind_PRESENT) {}
+    StreamId(uint64_t _column, StreamKind _kind) : column(_column), kind(_kind) {}
+
+    bool operator==(const StreamId& other) const {
+      return column == other.column && kind == other.kind;
+    }
+
+    bool operator!=(const StreamId& other) const {
+      return !(*this == other);
+    }
+
+    bool operator<(const StreamId& other) const {
+      if (column != other.column) return column < other.column;
+      return kind < other.kind;
+    }
+
+    uint64_t getColumnId() const { return column; }
+    StreamKind getKind() const { return kind; }
   };
 
