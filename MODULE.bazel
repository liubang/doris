# =============================================================================
# C++ Non-BCR Dependencies (via http_archive in extension)
# =============================================================================
# The following C++ dependencies are NOT available in BCR and are managed
# through a custom module extension in //third_party/cpp:extensions.bzl:
#   - protobuf 21.11 (C++ runtime for BE, pinned for brpc compatibility)
#   - brpc 1.4.0 (RPC framework)
#   - Apache Thrift 0.16.0 (C++ library)
#   - Apache Arrow 17.0.0 (columnar format)
#   - Apache ORC 1.9.0 (columnar storage)
#   - RocksDB 5.14.2 (embedded KV store)
#   - jemalloc 5.3.0 (memory allocator)
#   - libunwind 1.6.2 (stack unwinding)
#   - gperftools 2.10 (tcmalloc)
#   - libevent 2.1.12 (event notification)
#   - librdkafka 2.11.0 (Kafka client)
#   - Hyperscan/Vectorscan 5.4.x (regex engine)
#   - CRoaring 2.1.2 (bitmap)
#   - S2 Geometry 0.10.0
#   - CLucene (full-text search)
#   - OpenSSL 1.1.1s (BE uses OpenSSL, not BoringSSL for runtime)
#   - leveldb (embedded KV)
#   - rapidjson (JSON parser)

cpp_deps = use_extension("//third_party/cpp:extensions.bzl", "cpp_deps")
use_repo(
    cpp_deps,
    "fmt",
    "protobuf_21",
    "brpc",
    "thrift_cpp",
    "arrow",
    "orc",
    "rocksdb",
    "jemalloc",
    "libunwind",
    "gperftools",
    "libevent",
    "librdkafka",
    "hyperscan",
    "vectorscan",
    "croaring",
    "s2geometry",
    "clucene",
    "openssl",
    "leveldb",
    "rapidjson",
    "parallel_hashmap",
    "cctz",
    "pdqsort",
    "concurrentqueue",
    "xxhash",
    "sse2neon",
    "fast_float",
    "cpp_timsort",
    "aws_sdk",
    "libbase64",
    "streamvbyte",
    "lz4_compat",
    "bitshuffle",
    "libdivide",
    "pugixml",
)
