load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin")
load("//tools/bazel:antlr4.bzl", "antlr4_java_library")
load("//tools/bazel:pattern_generator.bzl", "pattern_generator")

package(default_visibility = ["//fe:__subpackages__"])

# =============================================================================
# ANTLR4 Grammar Code Generation
# =============================================================================

# Nereids SQL Parser (main SQL grammar)
antlr4_java_library(
    name = "nereids_parser_gen",
    srcs = [
        "src/main/antlr4/org/apache/doris/nereids/DorisLexer.g4",
        "src/main/antlr4/org/apache/doris/nereids/DorisParser.g4",
    ],
    package = "org.apache.doris.nereids",
)

# Nereids PL/SQL Parser (imports DorisParser grammar)
antlr4_java_library(
    name = "nereids_pl_parser_gen",
    srcs = [
        "src/main/antlr4/org/apache/doris/nereids/PLLexer.g4",
        "src/main/antlr4/org/apache/doris/nereids/PLParser.g4",
    ],
    imports = [
        "src/main/antlr4/org/apache/doris/nereids/DorisLexer.g4",
        "src/main/antlr4/org/apache/doris/nereids/DorisParser.g4",
    ],
    package = "org.apache.doris.nereids",
)

# Java Parser (used by PatternDescribableProcessor)
antlr4_java_library(
    name = "java_parser_gen",
    srcs = [
        "src/main/antlr4/org/apache/doris/nereids/JavaLexer.g4",
        "src/main/antlr4/org/apache/doris/nereids/JavaParser.g4",
    ],
    package = "org.apache.doris.nereids",
)

# Search Parser
antlr4_java_library(
    name = "search_parser_gen",
    srcs = [
        "src/main/antlr4/org/apache/doris/nereids/search/SearchLexer.g4",
        "src/main/antlr4/org/apache/doris/nereids/search/SearchParser.g4",
    ],
    package = "org.apache.doris.nereids.search",
)

# SQL Separator Parser
antlr4_java_library(
    name = "sql_separator_gen",
    srcs = [
        "src/main/antlr4/org/apache/doris/parser/DorisSqlSeparator.g4",
    ],
    package = "org.apache.doris.parser",
)

# =============================================================================
# Custom Annotation Processor: PatternDescribableProcessor
# =============================================================================

# 注解处理器依赖 ANTLR4 生成的 JavaLexer/JavaParser
java_library(
    name = "pattern_generator_lib",
    srcs = glob(["src/main/java/org/apache/doris/nereids/pattern/generator/**/*.java"]),
    deps = [
        ":java_parser_gen",
        "@maven//:com_google_guava_guava",
        "@maven//:commons_io_commons_io",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_apache_commons_commons_lang3",
    ],
)

java_plugin(
    name = "pattern_describable_plugin",
    processor_class = "org.apache.doris.nereids.pattern.generator.PatternDescribableProcessor",
    deps = [":pattern_generator_lib"],
)

# Standalone binary for pattern generation (replaces -proc:only approach)
java_binary(
    name = "pattern_generator_tool",
    main_class = "org.apache.doris.nereids.pattern.generator.PatternGeneratorMain",
    srcs = ["src/main/java/org/apache/doris/nereids/pattern/generator/PatternGeneratorMain.java"],
    deps = [
        ":pattern_generator_lib",
        ":java_parser_gen",
        "@maven//:com_google_guava_guava",
        "@maven//:commons_io_commons_io",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_apache_commons_commons_lang3",
    ],
)

# Generate pattern source files
pattern_generator(
    name = "generated_patterns",
    srcs = glob(["src/main/java/org/apache/doris/nereids/**/*.java"]),
    tool = ":pattern_generator_tool",
)

# =============================================================================
# Lombok Annotation Processor
# =============================================================================

java_plugin(
    name = "lombok_plugin",
    processor_class = "lombok.launch.AnnotationProcessorHider$AnnotationProcessor",
    deps = ["@maven//:org_projectlombok_lombok"],
)

# =============================================================================
# Immutables Annotation Processor
# =============================================================================

java_plugin(
    name = "immutables_plugin",
    processor_class = "org.immutables.processor.ProxyProcessor",
    deps = ["@maven//:org_immutables_value"],
)

