# Bazel toolchain and build utilities

load("@rules_java//java:defs.bzl", "java_binary")

# ANTLR4 Tool - used by antlr4.bzl to generate parser code
java_binary(
    name = "antlr4_tool",
    main_class = "org.antlr.v4.Tool",
    visibility = ["//visibility:public"],
    runtime_deps = [
        "@maven//:org_antlr_antlr4",
    ],
)
